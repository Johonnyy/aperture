{
  "name": "aperture",
  "version": "0.1.0",
  "description": "Amber's desktop client — chat, live trace, and an SSH bridge Amber can drive.",
  "main": "./out/main/index.js",
  "author": "Johnny Patino",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run verify:connection && npm run verify:install && npm run verify:typeahead && npm run verify:theme && npm run verify:bloom-keys && npm run verify:bloom-wire && npm run verify:bloom-client && npm run verify:bloom-stream",
    "verify:theme": "esbuild src/shared/theme.ts --bundle --platform=node --format=esm --outfile=out/verify/theme.mjs && node scripts/verify-theme.mjs",
    "verify:typeahead": "esbuild src/renderer/ssh/typeahead.ts --bundle --platform=node --format=esm --outfile=out/verify/typeahead.mjs && node scripts/verify-typeahead.mjs",
    "verify:connection": "esbuild src/main/amber/connection.ts --bundle --platform=node --format=esm --external:ws --outfile=out/verify/connection.mjs && node scripts/verify-connection.mjs",
    "verify:install": "esbuild src/main/ssh/authorized-keys.ts --bundle --platform=node --format=esm --outfile=out/verify/authorized-keys.mjs && node scripts/verify-install-command.mjs",
    "verify:bloom-keys": "esbuild src/main/bloom/keys.ts --bundle --platform=node --format=esm --outfile=out/verify/bloom-keys.mjs && node scripts/verify-bloom-keys.mjs",
    "verify:bloom-client": "esbuild src/main/bloom/client.ts --bundle --platform=node --format=esm --outfile=out/verify/client.mjs && node scripts/verify-bloom-client.mjs",
    "verify:bloom-wire": "esbuild src/main/bloom/wire.ts --bundle --platform=node --format=esm --outfile=out/verify/bloom-wire.mjs && node scripts/verify-bloom-wire.mjs",
    "verify:bloom-stream": "esbuild src/main/bloom/run-stream.ts --bundle --platform=node --format=esm --outfile=out/verify/run-stream.mjs && node scripts/verify-bloom-stream.mjs"
  },
  "dependencies": {
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "zustand": "^5.0.2"
  }
}
